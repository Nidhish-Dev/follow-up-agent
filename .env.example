# ==============================================================================
# GrapeLabs AI FollowUp Agent - Environment Variables (.env.example)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Firebase Client Configuration (Frontend Auth & Database)
# Obtain from: Firebase Console > Project Settings > General > Your apps (Web)
# Make sure to enable: Authentication > Sign-in method > Anonymous
# ------------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSy...
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project
NEXT_PUBLIC_FIREBASE_APP_ID=1:1234567890:web:abcdef123456

# ------------------------------------------------------------------------------
# 2. Firebase Admin SDK Configuration (Server-Side Firestore Access)
# Obtain from: Firebase Console > Project Settings > Service Accounts > Generate new private key
# ------------------------------------------------------------------------------
FIREBASE_PROJECT_ID=your-project
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
# Wrap private key in double quotes and preserve escaped newlines (\n)
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# ------------------------------------------------------------------------------
# 3. Credential Encryption Key
# 32-byte key used by AES-256-GCM to encrypt third-party credentials in Firestore.
# Must be either 64 hexadecimal characters OR 32-byte Base64-encoded string.
# Generate on Mac/Linux using terminal:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ------------------------------------------------------------------------------
CREDENTIAL_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ------------------------------------------------------------------------------
# 4. Automated Scheduler Security (Optional)
# Secret token to protect the POST /api/schedule/run endpoint when invoked by external cron
# Pass as header 'x-cron-secret' when calling from external schedulers (e.g. Vercel Cron, GitHub Actions)
# ------------------------------------------------------------------------------
CRON_SECRET=your_super_secret_cron_token_here